    "ResultsCsvPath": "Results/measurements.csv",
    "SummaryCsvPath": "Results/summary.csv",

    "ExperimentTag": "main",
    "CollectResourceMetrics": false,
    "OlapMaxDopVariants": [ 0 ],
    "SyncIntervalsSeconds": [ 0 ],
    "ResourceUsageCsvPath": "Results/resource_usage.csv",
    "WaitStatsCsvPath": "Results/wait_stats.csv",
    "SyncCyclesCsvPath": "Results/sync_cycles.csv"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
